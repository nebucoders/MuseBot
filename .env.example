# Copy this file to .env and fill in your real keys. .env is gitignored -
# never commit real keys.

# --- Chat model switcher: "google" (default) or "groq" ---
LLM_PROVIDER=google

# Required if LLM_PROVIDER=google. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Required if LLM_PROVIDER=groq, and always required for Whisper STT.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Which mic to record from. Requires the `pipewire-alsa` system package
# (apt install pipewire-alsa) so PortAudio's "default" device routes
# through PipeWire instead of opening ALSA hardware directly - without it,
# capture can intermittently fail with "Device or resource busy" or the
# mic vanishing from the device list, from racing PipeWire/WirePlumber for
# the same hardware node.
#
# With pipewire-alsa installed, leave MIC_DEVICE_NAME_MATCH and
# MIC_DEVICE_INDEX below blank and use MIC_PULSE_SOURCE_NAME instead (see
# below) to pick the mic - that's the stable, race-free path. Only set
# MIC_DEVICE_NAME_MATCH (a substring of the device name or vendor:product
# ID, e.g. "046d:081b") or MIC_DEVICE_INDEX (a raw PortAudio index, run
# `python3 mic_check.py --list` to see current values) to force opening a
# specific ALSA hardware device directly, bypassing PipeWire - not
# recommended, kept as an escape hatch. If both are set,
# MIC_DEVICE_NAME_MATCH wins.
MIC_DEVICE_NAME_MATCH=
MIC_DEVICE_INDEX=

# Re-asserted as PipeWire's default input source before every listen (it
# can silently revert on its own between sessions). This is a PipeWire
# node.name, not a PulseAudio source name - there's no PulseAudio daemon
# under PipeWire, and pactl isn't installed here; the code looks this name
# up via `pw-dump` and applies it with `wpctl set-default`. Find the exact
# name with `pw-dump | grep node.name` or `wpctl status`. Leave blank to
# skip this and just trust whatever PipeWire's default already is.
MIC_PULSE_SOURCE_NAME=

# Which speaker to play TTS/cues through, as an ALSA device string. ALSA's
# "default" PCM isn't reliable under a headless systemd service (can route
# to the wrong card or fail to open at all). Run `aplay -l` to find your
# card/device numbers. Also used to pick which card's volume gets set to
# 100% at startup. Defaults to "plughw:2,0" if left blank.
AUDIO_OUTPUT_DEVICE=

# --- Optional overrides, defaults shown are already sensible ---
# GOOGLE_MODEL=gemini-flash-lite-latest
# GROQ_QWEN_MODEL=qwen/qwen3.6-27b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# EDGE_TTS_VOICE=en-US-AriaNeural
